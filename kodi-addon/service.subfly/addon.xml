<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="service.subfly"
       name="SubFly Live Subtitles"
       version="1.0.0"
       provider-name="SubFly">
  <requires>
    <import addon="xbmc.python" version="3.0.0"/>
  </requires>
  <extension point="xbmc.service" library="service.py" start="startup"/>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Live English subtitles powered by SubFly</summary>
    <description lang="en_GB">
      Streams audio from the playing media to your Unraid SubFly GPU service
      (faster-whisper on Tesla T4) and overlays live English captions on any video.
    </description>
    <platform>all</platform>
    <license>MIT</license>
    <assets>
      <icon>resources/icon.png</icon>
    </assets>
  </extension>
</addon>
